// Chèn phần tử vào vị trí k
chenPhanTu(int arr[], int &n, int x, int k) {
    for (int i = n; i > k; i--) {
        arr[i] = arr[i - 1];
}
    arr[k] = x;
    n++;
}

// Xóa phần tử ở vị trí k
xoaPhanTu(int arr[], int &n, int k) {
    if (k < 0 || k >= n) {
        printf ("Vi tri xoa khong hop le!");
        return;
    }
    for (int i = k; i < n - 1; i++) {
        arr[i] = arr[i + 1];
    }
    n--;
}
