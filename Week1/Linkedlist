// cài đặt linked list:
struct Node{
public
int data;
Node* next;
Node(int x){
this -> data = x;
this -> next = null;
}
}
// chèn tại head:
Node* insertHead(Node* head, int x){
Node* a = new Node(x);
a -> = head;
head = a;
return head;
}
// chèn tại tail:
Node* insertTail(Node*head, int x){
Node* p = new Node(x);
p -> next = nullptr;
Node* tmp = head;
while (tmp -> next != nullptr){
tmp = tmp -> next;
}
tmp -> next = p;
return head;
}
// chèn tại điểm k
Node* insertK(Node* head, int x, int k){
if (k == 0){
head = insertHead(head, x);
}
else{
Node* p = new Node(x);
int pos = 0;
Node* tmp = head;
while (pos < k-1){
tmp = tmp -> next;
pos ++;
}
p -> next = tmp -> next;
tmp -> next = p;
return head;
}
