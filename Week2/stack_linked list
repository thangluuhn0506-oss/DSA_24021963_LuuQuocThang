#include <iostream>
#include <stdexcept>
using namespace std;

class Stack {
private:
    struct Node {
        int data;
        Node* next;
        Node(int val) : data(val), next(nullptr) {}
    };

    Node* head;   
    int count;    

public:
    Stack() : head(nullptr), count(0) {}

    ~Stack() {
        while (!isEmpty()) pop();
    }

    // Trả về true nếu stack rỗng
    bool isEmpty() {
        return head == nullptr;
    }

    // Chèn một phần tử vào stack: thêm vào đầu danh sách -> O(1)
    void push(int item) {
        Node* newNode = new Node(item);
        newNode->next = head;
        head = newNode;
        count++;
    }

    // Xóa phần tử cuối khỏi stack và trả về phần tử đó -> O(1)
    int pop() {
        if (isEmpty()) throw runtime_error("Stack rong!");
        Node* temp = head;
        int value = temp->data;
        head = head->next;
        delete temp;
        count--;
        return value;
    }

    // Trả về kích thước của stack
    int size() {
        return count;
    }

    // Trả về giá trị phần tử cuối (không xóa)
    int top() {
        if (isEmpty()) throw runtime_error("Stack rong!");
        return head->data;
    }
};

int main() {
    Stack s;
    cout << "Rong? " << (s.isEmpty() ? "true" : "false") << endl;

    s.push(10);
    s.push(20);
    s.push(30);

    cout << "Size: " << s.size() << endl;   // 3
    cout << "Top: " << s.top() << endl;     // 30
    cout << "Pop: " << s.pop() << endl;     // 30
    cout << "Pop: " << s.pop() << endl;     // 20
    cout << "Size: " << s.size() << endl;   // 1
    cout << "Rong? " << (s.isEmpty() ? "true" : "false") << endl;
    return 0;
}
