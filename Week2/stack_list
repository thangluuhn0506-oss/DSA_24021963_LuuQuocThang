#include <iostream>
#include <list>
#include <stdexcept>
using namespace std;

class Stack {
private:
    list<int> data;   

public:
    // Trả về true nếu stack rỗng
    bool isEmpty() {
        return data.empty();
    }

    // Chèn một phần tử vào stack -> O(1)
    void push(int item) {
        data.push_back(item);
    }

    // Xóa phần tử cuối khỏi stack và trả về phần tử đó -> O(1)
    int pop() {
        if (isEmpty()) throw runtime_error("Stack rong!");
        int value = data.back();
        data.pop_back();
        return value;
    }

    // Trả về kích thước của stack -> O(1)
    int size() {
        return data.size();
    }

    // Trả về giá trị phần tử cuối (không xóa)
    int top() {
        if (isEmpty()) throw runtime_error("Stack rong!");
        return data.back();
    }
};

int main() {
    Stack s;
    cout << "Rong? " << (s.isEmpty() ? "true" : "false") << endl;

    s.push(10);
    s.push(20);
    s.push(30);

    cout << "Size: " << s.size() << endl;   // 3
    cout << "Top: " << s.top() << endl;     // 30
    cout << "Pop: " << s.pop() << endl;     // 30
    cout << "Pop: " << s.pop() << endl;     // 20
    cout << "Size: " << s.size() << endl;   // 1
    cout << "Rong? " << (s.isEmpty() ? "true" : "false") << endl;
    return 0;
}
